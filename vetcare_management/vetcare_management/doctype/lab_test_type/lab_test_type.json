{
  "name": "Lab Test Type",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "naming_rule": "By fieldname",
  "autoname": "field:test_name",
  "fields": [
    {"fieldname": "test_name", "label": "Test Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "category", "label": "Category", "fieldtype": "Select", "options": "Hematology\nBiochemistry\nMicrobiology\nParasitology\nUrinalysis\nCytology\nHistopathology\nSerology\nHormone\nOther", "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "test_rate", "label": "Test Rate", "fieldtype": "Currency"},
    {"fieldname": "turnaround_time", "label": "Turnaround Time (hours)", "fieldtype": "Int"},
    {"fieldname": "normal_range", "label": "Normal Range / Reference", "fieldtype": "Small Text"},
    {"fieldname": "description", "label": "Description", "fieldtype": "Text"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Vet Lab Technician", "read": 1},
    {"role": "Veterinarian", "read": 1}
  ]
}
