{
  "name": "Patient Pet",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "naming_rule": "Expression",
  "autoname": "PET-.####",
  "title_field": "pet_name",
  "search_fields": "pet_name,owner,species,breed",
  "image_field": "pet_photo",
  "fields": [
    {"fieldname": "pet_name", "label": "Pet Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Link", "options": "Pet Owner", "reqd": 1, "in_list_view": 1},
    {"fieldname": "owner_name", "label": "Owner Name", "fieldtype": "Data", "fetch_from": "owner.full_name", "read_only": 1},
    {"fieldname": "sec_basic", "label": "Basic Information", "fieldtype": "Section Break"},
    {"fieldname": "species", "label": "Species", "fieldtype": "Link", "options": "Animal Species", "reqd": 1, "in_list_view": 1},
    {"fieldname": "breed", "label": "Breed", "fieldtype": "Link", "options": "Animal Breed"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "gender", "label": "Gender", "fieldtype": "Select", "options": "\nMale\nFemale", "reqd": 1},
    {"fieldname": "date_of_birth", "label": "Date of Birth", "fieldtype": "Date"},
    {"fieldname": "age", "label": "Age", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "color", "label": "Color / Coat", "fieldtype": "Data"},
    {"fieldname": "weight_kg", "label": "Weight (kg)", "fieldtype": "Float"},
    {"fieldname": "microchip_id", "label": "Microchip ID", "fieldtype": "Data", "unique": 1},
    {"fieldname": "sec_health", "label": "Health & Status", "fieldtype": "Section Break"},
    {"fieldname": "is_neutered", "label": "Neutered / Spayed", "fieldtype": "Check"},
    {"fieldname": "is_deceased", "label": "Deceased", "fieldtype": "Check"},
    {"fieldname": "date_of_death", "label": "Date of Death", "fieldtype": "Date", "depends_on": "is_deceased"},
    {"fieldname": "col_break_4", "fieldtype": "Column Break"},
    {"fieldname": "blood_group", "label": "Blood Group", "fieldtype": "Select", "options": "\nDEA 1.1+\nDEA 1.1-\nDEA 1.2+\nDEA 1.2-\nUnknown"},
    {"fieldname": "allergies", "label": "Known Allergies", "fieldtype": "Small Text"},
    {"fieldname": "sec_photo", "label": "Photo", "fieldtype": "Section Break", "collapsible": 1},
    {"fieldname": "pet_photo", "label": "Pet Photo", "fieldtype": "Attach Image"},
    {"fieldname": "sec_notes", "label": "Notes", "fieldtype": "Section Break", "collapsible": 1},
    {"fieldname": "special_notes", "label": "Special Notes", "fieldtype": "Text Editor"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Veterinarian", "read": 1, "write": 1, "create": 1},
    {"role": "Vet Receptionist", "read": 1, "write": 1, "create": 1},
    {"role": "Vet Lab Technician", "read": 1}
  ],
  "track_changes": 1,
  "quick_entry": 1
}
