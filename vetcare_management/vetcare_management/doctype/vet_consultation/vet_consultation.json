{
  "name": "Vet Consultation",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "is_submittable": 1,
  "naming_rule": "Expression",
  "autoname": "CON-.YYYY.-.####",
  "title_field": "patient_name",
  "fields": [
    {"fieldname": "appointment", "label": "Appointment", "fieldtype": "Link", "options": "Vet Appointment", "in_list_view": 1},
    {"fieldname": "patient", "label": "Patient (Pet)", "fieldtype": "Link", "options": "Patient Pet", "reqd": 1, "in_list_view": 1},
    {"fieldname": "patient_name", "label": "Pet Name", "fieldtype": "Data", "fetch_from": "patient.pet_name", "read_only": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Link", "options": "Pet Owner", "reqd": 1},
    {"fieldname": "consultation_date", "label": "Consultation Date", "fieldtype": "Date", "reqd": 1, "default": "Today"},
    {"fieldname": "veterinarian", "label": "Veterinarian", "fieldtype": "Link", "options": "Veterinarian", "reqd": 1},
    {"fieldname": "sec_vitals", "label": "Vital Signs", "fieldtype": "Section Break"},
    {"fieldname": "weight_kg", "label": "Weight (kg)", "fieldtype": "Float"},
    {"fieldname": "temperature_c", "label": "Temperature (°C)", "fieldtype": "Float"},
    {"fieldname": "heart_rate", "label": "Heart Rate (bpm)", "fieldtype": "Int"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "respiratory_rate", "label": "Respiratory Rate", "fieldtype": "Int"},
    {"fieldname": "mucous_membrane", "label": "Mucous Membrane", "fieldtype": "Select", "options": "\nPink\nPale\nWhite\nBlue\nYellow\nBright Red"},
    {"fieldname": "capillary_refill", "label": "Capillary Refill Time", "fieldtype": "Select", "options": "\n< 2 seconds (Normal)\n2-3 seconds (Prolonged)\n> 3 seconds (Severely Prolonged)"},
    {"fieldname": "sec_clinical", "label": "Clinical Findings", "fieldtype": "Section Break"},
    {"fieldname": "chief_complaint", "label": "Chief Complaint", "fieldtype": "Text", "reqd": 1},
    {"fieldname": "clinical_examination", "label": "Clinical Examination", "fieldtype": "Text Editor"},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "diagnosis", "label": "Diagnosis", "fieldtype": "Text Editor", "reqd": 1},
    {"fieldname": "differential_diagnosis", "label": "Differential Diagnosis", "fieldtype": "Small Text"},
    {"fieldname": "sec_treatment", "label": "Treatment Plan", "fieldtype": "Section Break"},
    {"fieldname": "treatment_plan", "label": "Treatment Plan", "fieldtype": "Text Editor"},
    {"fieldname": "follow_up_date", "label": "Follow-up Date", "fieldtype": "Date"},
    {"fieldname": "col_break_4", "fieldtype": "Column Break"},
    {"fieldname": "prognosis", "label": "Prognosis", "fieldtype": "Select", "options": "\nGood\nFair\nGuarded\nPoor\nGrave"},
    {"fieldname": "referral_needed", "label": "Referral Needed", "fieldtype": "Check"},
    {"fieldname": "referral_notes", "label": "Referral Notes", "fieldtype": "Small Text", "depends_on": "referral_needed"},
    {"fieldname": "sec_prescription", "label": "Prescription", "fieldtype": "Section Break"},
    {"fieldname": "prescription", "label": "Prescription", "fieldtype": "Link", "options": "Prescription"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Veterinarian", "read": 1, "write": 1, "create": 1, "submit": 1},
    {"role": "Vet Receptionist", "read": 1}
  ],
  "track_changes": 1
}
