{
  "name": "Hospital Ward",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "naming_rule": "By fieldname",
  "autoname": "field:ward_name",
  "fields": [
    {"fieldname": "ward_name", "label": "Ward Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "ward_type", "label": "Ward Type", "fieldtype": "Select", "options": "General\nICU\nPost-Op\nIsolation\nNeonatal\nBoarding", "in_list_view": 1},
    {"fieldname": "branch", "label": "Branch", "fieldtype": "Link", "options": "Branch Clinic"},
    {"fieldname": "capacity", "label": "Total Capacity", "fieldtype": "Int"},
    {"fieldname": "description", "label": "Description", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Veterinarian", "read": 1},
    {"role": "Vet Receptionist", "read": 1}
  ]
}
