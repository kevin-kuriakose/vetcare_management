{
  "name": "Vet Appointment",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "is_submittable": 1,
  "naming_rule": "Expression",
  "autoname": "APT-.YYYY.-.####",
  "title_field": "patient_name",
  "search_fields": "patient_name,owner,veterinarian,status",
  "fields": [
    {"fieldname": "patient", "label": "Patient (Pet)", "fieldtype": "Link", "options": "Patient Pet", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "patient_name", "label": "Pet Name", "fieldtype": "Data", "fetch_from": "patient.pet_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Link", "options": "Pet Owner", "reqd": 1},
    {"fieldname": "owner_name", "label": "Owner Name", "fieldtype": "Data", "fetch_from": "owner.full_name", "read_only": 1},
    {"fieldname": "sec_apt", "label": "Appointment Details", "fieldtype": "Section Break"},
    {"fieldname": "appointment_date", "label": "Appointment Date", "fieldtype": "Date", "reqd": 1, "in_list_view": 1, "default": "Today"},
    {"fieldname": "appointment_time", "label": "Appointment Time", "fieldtype": "Time", "reqd": 1},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "veterinarian", "label": "Veterinarian", "fieldtype": "Link", "options": "Veterinarian", "reqd": 1, "in_list_view": 1},
    {"fieldname": "veterinarian_name", "label": "Veterinarian Name", "fieldtype": "Data", "fetch_from": "veterinarian.full_name", "read_only": 1},
    {"fieldname": "branch", "label": "Branch / Clinic", "fieldtype": "Link", "options": "Branch Clinic"},
    {"fieldname": "sec_details", "label": "Consultation Details", "fieldtype": "Section Break"},
    {"fieldname": "appointment_type", "label": "Appointment Type", "fieldtype": "Select", "options": "Consultation\nVaccination\nGrooming\nSurgery\nLab Test\nFollow-up\nEmergency\nPhysiotherapy\nDentistry\nDermatology\nCardiology\nOphthalmology\nNeurology\nOncology", "reqd": 1, "in_list_view": 1},
    {"fieldname": "urgency_level", "label": "Urgency Level", "fieldtype": "Select", "options": "Normal\nUrgent\nEmergency", "default": "Normal"},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Scheduled\nConfirmed\nIn Progress\nCompleted\nCancelled\nNo Show", "default": "Scheduled", "in_list_view": 1},
    {"fieldname": "chief_complaint", "label": "Chief Complaint", "fieldtype": "Text", "reqd": 1},
    {"fieldname": "notes", "label": "Notes", "fieldtype": "Small Text"},
    {"fieldname": "sec_payment", "label": "Payment", "fieldtype": "Section Break", "collapsible": 1},
    {"fieldname": "consultation_fee", "label": "Consultation Fee", "fieldtype": "Currency"},
    {"fieldname": "payment_status", "label": "Payment Status", "fieldtype": "Select", "options": "Unpaid\nPaid\nWaived", "default": "Unpaid"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Veterinarian", "read": 1, "write": 1, "submit": 1},
    {"role": "Vet Receptionist", "read": 1, "write": 1, "create": 1}
  ],
  "track_changes": 1,
  "quick_entry": 1,
  "sort_field": "appointment_date",
  "sort_order": "DESC"
}
