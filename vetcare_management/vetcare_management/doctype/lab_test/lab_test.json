{
  "name": "Lab Test",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "is_submittable": 1,
  "naming_rule": "Expression",
  "autoname": "LAB-.YYYY.-.####",
  "fields": [
    {"fieldname": "patient", "label": "Patient (Pet)", "fieldtype": "Link", "options": "Patient Pet", "reqd": 1, "in_list_view": 1},
    {"fieldname": "patient_name", "label": "Pet Name", "fieldtype": "Data", "fetch_from": "patient.pet_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Link", "options": "Pet Owner"},
    {"fieldname": "veterinarian", "label": "Requested By", "fieldtype": "Link", "options": "Veterinarian"},
    {"fieldname": "test_date", "label": "Test Date", "fieldtype": "Date", "reqd": 1, "default": "Today"},
    {"fieldname": "lab_test_type", "label": "Lab Test Type", "fieldtype": "Link", "options": "Lab Test Type", "reqd": 1, "in_list_view": 1},
    {"fieldname": "consultation", "label": "Consultation", "fieldtype": "Link", "options": "Vet Consultation"},
    {"fieldname": "sec_sample", "label": "Sample Details", "fieldtype": "Section Break"},
    {"fieldname": "sample_type", "label": "Sample Type", "fieldtype": "Select", "options": "\nBlood\nUrine\nStool\nTissue\nSwab\nCSF\nSynovial Fluid\nOther"},
    {"fieldname": "sample_collected_date", "label": "Sample Collected", "fieldtype": "Datetime"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "lab_technician", "label": "Lab Technician", "fieldtype": "Data"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Requested\nSample Collected\nIn Progress\nCompleted\nCancelled", "default": "Requested", "in_list_view": 1},
    {"fieldname": "sec_results", "label": "Test Results", "fieldtype": "Section Break"},
    {"fieldname": "result_value", "label": "Result", "fieldtype": "Text Editor"},
    {"fieldname": "normal_range", "label": "Normal Range", "fieldtype": "Data", "fetch_from": "lab_test_type.normal_range", "read_only": 1},
    {"fieldname": "col_break_3", "fieldtype": "Column Break"},
    {"fieldname": "interpretation", "label": "Interpretation", "fieldtype": "Select", "options": "\nNormal\nAbnormal - Low\nAbnormal - High\nCritical\nInconclusive"},
    {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Small Text"},
    {"fieldname": "attachment", "label": "Report Attachment", "fieldtype": "Attach"},
    {"fieldname": "sec_billing", "label": "Billing", "fieldtype": "Section Break", "collapsible": 1},
    {"fieldname": "test_amount", "label": "Test Amount", "fieldtype": "Currency", "fetch_from": "lab_test_type.test_rate"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Vet Lab Technician", "read": 1, "write": 1, "submit": 1},
    {"role": "Veterinarian", "read": 1, "write": 1, "create": 1},
    {"role": "Vet Receptionist", "read": 1}
  ],
  "track_changes": 1
}
