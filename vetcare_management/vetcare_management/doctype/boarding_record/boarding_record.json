{
  "name": "Boarding Record",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "is_submittable": 1,
  "naming_rule": "Expression",
  "autoname": "BRD-.YYYY.-.####",
  "fields": [
    {"fieldname": "patient", "label": "Patient (Pet)", "fieldtype": "Link", "options": "Patient Pet", "reqd": 1, "in_list_view": 1},
    {"fieldname": "patient_name", "label": "Pet Name", "fieldtype": "Data", "fetch_from": "patient.pet_name", "read_only": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Link", "options": "Pet Owner", "reqd": 1},
    {"fieldname": "check_in_date", "label": "Check-In Date", "fieldtype": "Datetime", "reqd": 1, "in_list_view": 1},
    {"fieldname": "expected_check_out", "label": "Expected Check-Out", "fieldtype": "Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "actual_check_out", "label": "Actual Check-Out", "fieldtype": "Datetime"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "kennel_no", "label": "Kennel / Room No", "fieldtype": "Data"},
    {"fieldname": "daily_rate", "label": "Daily Rate", "fieldtype": "Currency"},
    {"fieldname": "total_days", "label": "Total Days", "fieldtype": "Int", "read_only": 1},
    {"fieldname": "total_amount", "label": "Total Amount", "fieldtype": "Currency", "read_only": 1},
    {"fieldname": "special_diet", "label": "Special Diet Instructions", "fieldtype": "Small Text"},
    {"fieldname": "medication_instructions", "label": "Medication Instructions", "fieldtype": "Small Text"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Booked\nChecked In\nChecked Out\nCancelled", "default": "Booked", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Vet Receptionist", "read": 1, "write": 1, "create": 1, "submit": 1}
  ]
}
