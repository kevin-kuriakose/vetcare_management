{
  "name": "Surgery Record",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "is_submittable": 1,
  "naming_rule": "Expression",
  "autoname": "SUR-.YYYY.-.####",
  "fields": [
    {"fieldname": "patient", "label": "Patient (Pet)", "fieldtype": "Link", "options": "Patient Pet", "reqd": 1, "in_list_view": 1},
    {"fieldname": "patient_name", "label": "Pet Name", "fieldtype": "Data", "fetch_from": "patient.pet_name", "read_only": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "owner", "label": "Owner", "fieldtype": "Link", "options": "Pet Owner", "reqd": 1},
    {"fieldname": "surgery_date", "label": "Surgery Date", "fieldtype": "Datetime", "reqd": 1, "in_list_view": 1},
    {"fieldname": "surgeon", "label": "Lead Surgeon", "fieldtype": "Link", "options": "Veterinarian", "reqd": 1},
    {"fieldname": "surgery_type", "label": "Surgery Type", "fieldtype": "Select", "options": "Elective\nEmergency\nOrthopedic\nCardiothoracic\nAbdominal\nDental\nOphthalmologic\nNeurological\nTumor Removal\nC-Section\nCastration\nSpaying\nOther", "reqd": 1, "in_list_view": 1},
    {"fieldname": "sec_procedure", "label": "Procedure Details", "fieldtype": "Section Break"},
    {"fieldname": "pre_op_notes", "label": "Pre-Op Notes", "fieldtype": "Text Editor"},
    {"fieldname": "anesthesia_type", "label": "Anesthesia Type", "fieldtype": "Select", "options": "\nGeneral\nLocal\nEpidural\nSedation"},
    {"fieldname": "col_break_2", "fieldtype": "Column Break"},
    {"fieldname": "intra_op_notes", "label": "Intra-Op Notes", "fieldtype": "Text Editor"},
    {"fieldname": "post_op_notes", "label": "Post-Op Notes", "fieldtype": "Text Editor"},
    {"fieldname": "complications", "label": "Complications", "fieldtype": "Small Text"},
    {"fieldname": "outcome", "label": "Outcome", "fieldtype": "Select", "options": "\nSuccessful\nPartially Successful\nComplicated\nUnsuccessful\nPatient Expired"},
    {"fieldname": "surgery_cost", "label": "Surgery Cost", "fieldtype": "Currency"},
    {"fieldname": "sec_consent", "label": "Consent", "fieldtype": "Section Break", "collapsible": 1},
    {"fieldname": "consent_obtained", "label": "Consent Obtained", "fieldtype": "Check"},
    {"fieldname": "consent_date", "label": "Consent Date", "fieldtype": "Date", "depends_on": "consent_obtained"}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1},
    {"role": "Veterinarian", "read": 1, "write": 1, "create": 1, "submit": 1}
  ],
  "track_changes": 1
}
