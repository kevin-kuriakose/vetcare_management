{
  "name": "Branch Clinic",
  "module": "Vetcare Management",
  "doctype": "DocType",
  "naming_rule": "By fieldname",
  "autoname": "field:branch_name",
  "fields": [
    {"fieldname": "branch_name", "label": "Branch Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "city", "label": "City", "fieldtype": "Data", "in_list_view": 1},
    {"fieldname": "col_break_1", "fieldtype": "Column Break"},
    {"fieldname": "phone", "label": "Phone", "fieldtype": "Phone"},
    {"fieldname": "email", "label": "Email", "fieldtype": "Data", "options": "Email"},
    {"fieldname": "address", "label": "Address", "fieldtype": "Small Text"},
    {"fieldname": "services", "label": "Services Available", "fieldtype": "Small Text"},
    {"fieldname": "operating_hours", "label": "Operating Hours", "fieldtype": "Small Text"},
    {"fieldname": "is_active", "label": "Is Active", "fieldtype": "Check", "default": "1", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "Vet Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Veterinarian", "read": 1},
    {"role": "Vet Receptionist", "read": 1}
  ]
}
